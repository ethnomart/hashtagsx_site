# Required
ADMIN_PASSWORD=choose-a-long-password
# Postgres connection string (Supabase / Neon / Railway / Render). Without it, orders go to a local file only.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Comma-separated list of sites allowed to call this API (no trailing slash)
ALLOWED_ORIGINS=https://your-store.vercel.app,https://your-admin.vercel.app
